---
import { CenterTitle, SkillTitle, SkillGrid } from "@components/UI";
const skillStacks = await import("@/constants/skillStack");

const WorkWithStack = skillStacks.WorkWithStack;
const DatabaseStack = skillStacks.DatabaseStack;
const LearningStack = skillStacks.LearningStack;
---

<section id="skills" class="w-full min-h-screen py-4 pt-14 bg-background">
    <CenterTitle title="Tech Stack" color="primary" />

    <div
        class="Fade_Up flex justify-center items-start flex-col lg:flex-row gap-8 px-4"
    >
        <div
            class="Fade_Up flex_center flex-col gap-4 py-4 xs:p-4 w-full lg:w-1/3 h-full"
        >
            <SkillTitle title="I Can Work With" color="primary" />
            <SkillGrid stack={WorkWithStack} />
        </div>

        <div
            class="Fade_Up flex_center flex-col gap-4 py-4 xs:p-4 w-full lg:w-1/3 h-full"
        >
            <SkillTitle title="Databases" color="primary" />
            <SkillGrid stack={DatabaseStack} />
        </div>

        <div
            class="Fade_Up flex_center flex-col gap-4 py-4 xs:p-4 w-full lg:w-1/3 h-full"
        >
            <SkillTitle title="Learning Now" color="primary" />
            <SkillGrid stack={LearningStack} />
        </div>
    </div>
</section>
