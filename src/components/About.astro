---
import { Image } from "astro:assets";
import { SectionTitle } from "@components/UI";

const { config } = Astro.props;
---

<section id="about" class="w-full min-h-screen py-4 pt-14 bg-background">
    <SectionTitle
        title="About Me"
        color="primary"
        className="min-h-[calc(100vh-4rem)] flex flex-col justify-between py-6 lg:py-10"
    >
        <div class="flex_center flex-col lg:flex-row w-full h-full py-6 lg:py-10 gap-8">
            <Image
                src={config.aboutAvatar}
                alt="About_Avatar"
                class="Fade_Up rounded-full scale-x-[-1] w-[180px] h-[180px] sm:w-[220px] sm:h-[220px] lg:w-[250px] lg:h-[250px] object-cover lg:mx-14"
                width={250}
                height={250}
                loading="lazy"
                decoding="async"
            />

            <div
                class="Fade_Up w-full md:w-[80%] lg:w-[60%] flex justify-center items-start flex-col gap-4 lg:border-l border-primary py-4 lg:py-8 lg:pl-10 px-4 lg:px-0"
            >
                <h2 class="Fade_Up text-[1.5em] font-bold">Hey there! 👋🏻</h2>
                {
                    config.description &&
                        config.description.map((para: string) => (
                            <p class="Fade_Up text-justify">{para}</p>
                        ))
                }
            </div>
        </div>
    </SectionTitle>
</section>
