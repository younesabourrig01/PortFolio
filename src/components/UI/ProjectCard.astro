---
import { GithubIcon } from "@/assets/SVGs";
import type { IProject } from "@/config/ProjectsList";
import { Image } from "astro:assets";
import { ArrowUpRightIcon, ArrowRightIcon } from "lucide-preact";

type Props = {
    project: IProject;
    className?: string;
};

const { project, className }: Props = Astro.props;

// PROJECT STATUS CHECK
let PROJECT_STATUS: "LIVE" | "BUILDING" | "COMPLETED" | "DOWN";
let statusClass = "statusBuilding";

if (project.status === "development") {
    PROJECT_STATUS = "BUILDING";
    statusClass = "statusBuilding";
} else if (project.liveUrl && project.liveUrl.trim() !== "") {
    let isLive = false;
    try {
        const res = await fetch(project.liveUrl, {
            method: "HEAD",
            redirect: "follow",
        });
        isLive = res.ok;
    } catch {
        isLive = false;
    }
    PROJECT_STATUS = isLive ? "LIVE" : "COMPLETED";
    statusClass = isLive ? "statusLive" : "statusLive";
} else {
    PROJECT_STATUS = "COMPLETED";
    statusClass = "statusLive";
}

const projectSlug = project?.name.replaceAll(" ", "-").toLowerCase();
const themeColor = project.theme || "#3b82f6";
---

<div
    class={`Project_Stagger Card_Main group relative flex flex-col w-full h-full bg-footerAlt/70 backdrop-blur-md border border-white/10 hover:border-primary/40 rounded-2xl overflow-hidden transition-all duration-300 hover:shadow-xl hover:shadow-primary/5 hover:-translate-y-1.5 opacity-0 ${className || ""}`}
>
    <!-- Card Banner / Preview Header -->
    <a
        href={`/projects/${projectSlug}`}
        class="Projects_Preview relative w-full h-48 sm:h-52 overflow-hidden flex items-center justify-center p-6 bg-gradient-to-br from-backgroundLite/90 via-footerAltLite/80 to-background/90 border-b border-white/10 transition-colors"
        style={`background-image: radial-gradient(circle at 50% 30%, ${themeColor}22 0%, transparent 70%);`}
    >
        <!-- Mockup Top Bar (Browser dots) -->
        <div class="absolute top-3 left-4 flex items-center gap-1.5 opacity-60">
            <span class="size-2.5 rounded-full bg-red-500/80"></span>
            <span class="size-2.5 rounded-full bg-yellow-500/80"></span>
            <span class="size-2.5 rounded-full bg-green-500/80"></span>
        </div>

        <!-- Status Chip Top-Right -->
        <div class="absolute top-3 right-4">
            <span
                class={`inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-semibold tracking-wider uppercase backdrop-blur-md ${statusClass}`}
            >
                <span class="relative flex h-2 w-2">
                    <span
                        class="animate-ping absolute inline-flex h-full w-full rounded-full opacity-75 bg-current"
                    ></span>
                    <span
                        class="relative inline-flex rounded-full h-2 w-2 bg-current"
                    ></span>
                </span>
                {PROJECT_STATUS}
            </span>
        </div>

        <!-- Center Logo Container -->
        <div class="relative z-10 flex flex-col items-center justify-center gap-2">
            <div
                class="size-20 sm:size-24 p-3 bg-background/80 backdrop-blur-md rounded-2xl border border-white/15 shadow-xl flex items-center justify-center group-hover:scale-105 group-hover:border-primary/40 transition-all duration-300"
            >
                <Image
                    src={project.logoImage}
                    alt={`Project_Logo_${project.name}`}
                    width={70}
                    height={70}
                    loading="lazy"
                    class="max-h-full max-w-full object-contain filter drop-shadow"
                />
            </div>
        </div>

        <!-- Subtle Glow Overlay on Hover -->
        <div
            class="absolute inset-0 bg-primary/5 opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none"
        >
        </div>
    </a>

    <!-- Card Content Body -->
    <div class="flex flex-col flex-1 p-5 sm:p-6 justify-between gap-4">
        <!-- Title & Direct Links -->
        <div class="flex items-start justify-between gap-3">
            <div>
                <a
                    href={`/projects/${projectSlug}`}
                    class="font-ubuntu text-xl sm:text-2xl font-bold tracking-tight text-foreground hover:text-primary transition-colors"
                >
                    {project.name}
                </a>
            </div>

            <!-- External Action Links -->
            <div class="flex items-center gap-2 shrink-0 pt-0.5">
                {
                    project.sourceUrl && (
                        <a
                            href={project.sourceUrl}
                            title={`${project.name} - GitHub`}
                            target="_blank"
                            rel="noreferrer"
                            class="Projects_Link p-1.5 rounded-lg text-muted-foreground hover:text-foreground hover:bg-backgroundLite transition-colors"
                        >
                            <GithubIcon width={18} height={18} aria-hidden="true" />
                            <span class="sr-only">{project.name} - GitHub</span>
                        </a>
                    )
                }
                {
                    project.liveUrl && (
                        <a
                            href={project.liveUrl}
                            title={`${project.name} Preview`}
                            target="_blank"
                            rel="noreferrer"
                            class="Projects_Link p-1.5 rounded-lg text-muted-foreground hover:text-primary hover:bg-backgroundLite transition-colors"
                        >
                            <ArrowUpRightIcon
                                width={18}
                                height={18}
                                aria-hidden="true"
                            />
                            <span class="sr-only">{project.name} Preview</span>
                        </a>
                    )
                }
            </div>
        </div>

        <!-- Description -->
        <p class="text-sm text-muted-foreground/90 leading-relaxed line-clamp-3">
            {project.shortDescription}
        </p>

        <!-- Tech Stack Badges -->
        <div class="flex flex-wrap items-center gap-2 pt-2 border-t border-white/5">
            {
                project.technologies?.slice(0, 5).map((tech) => (
                    <div
                        class="flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-backgroundLite/70 border border-white/10 text-xs font-medium text-foreground/80 hover:border-primary/30 transition-colors"
                        title={tech.title}
                    >
                        <Image
                            src={tech.icon}
                            alt={tech.title}
                            width={14}
                            height={14}
                            loading="lazy"
                            class="size-3.5 object-contain"
                        />
                        <span>{tech.title}</span>
                    </div>
                ))
            }
            {
                project.technologies && project.technologies.length > 5 && (
                    <span class="px-2 py-1 rounded-md bg-backgroundLite/50 text-xs text-muted-foreground font-medium">
                        +{project.technologies.length - 5}
                    </span>
                )
            }
        </div>

        <!-- Bottom CTA Button -->
        <a
            href={`/projects/${projectSlug}`}
            class="mt-2 flex items-center justify-between w-full px-4 py-2.5 rounded-xl bg-backgroundLite/80 hover:bg-primary hover:text-white border border-white/10 text-xs font-semibold tracking-wide transition-all duration-200 group/btn"
        >
            <span>View Details</span>
            <ArrowRightIcon
                class="size-4 transform group-hover/btn:translate-x-1 transition-transform"
            />
        </a>
    </div>
</div>

