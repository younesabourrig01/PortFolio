---
import { Image } from "astro:assets";

const { config } = Astro.props;
---

<section
    id="Hero"
    class="w-full min-h-[calc(100vh-4rem)] lg:h-[calc(100vh-4rem)] py-8 lg:py-4 bg-background flex justify-evenly lg:justify-around items-center flex-col-reverse lg:flex-row overflow-visible lg:overflow-hidden gap-6 lg:gap-0"
>
    <!-- Hero Intro Info -->
    <div class="w-full lg:w-fit flex justify-start items-center flex-col gap-6 lg:gap-8">
        <div class="text-[16px] sm:text-[18px] lg:text-[26px] text-center lg:text-left px-4 lg:px-0">
            <p class="Fade_Stagger">{config.salutation}</p>
            <h1
                class="Fade_Stagger gradientText font-ubuntu text-[2.5em] xs:text-[3em] sm:text-[3.75em] lg:text-[9rem] leading-tight max-w-sm sm:max-w-xl md:max-w-6xl"
            >
                {config.firstName}
                {" " + config.lastName}
            </h1>
            <p class="Fade_Stagger">I'm a {config.position}.</p>
            <p class="Fade_Stagger">
                {config.tagLine.prefixText}
                <span class="gradientText font-ubuntu">
                    {config.tagLine.highlightedText}
                </span>
                {config.tagLine.suffixText}
            </p>
        </div>

        <div
            class="Fade_Stagger flex justify-center lg:justify-start items-center w-full gap-8 sm:gap-10 py-2 sm:py-4 text-socialIconColor!"
        >
            {
                config.links &&
                    config.links.map(
                        (link: {
                            label: string;
                            url: string;
                            icon: string;
                        }) => (
                            <a
                                href={link.url}
                                title={link.label}
                                aria-label={link.label}
                                target="_blank"
                                rel="noreferrer"
                                class="Fade_Stagger w-9 h-9 flex items-center justify-center [&>svg]:w-full [&>svg]:h-full"
                            >
                                <Fragment set:html={link.icon} />
                            </a>
                        ),
                    )
            }
        </div>
    </div>

    <!-- Hero Orbit Animation -->
    <div
        class="Hero_Orbit relative flex_center w-[250px] xs:w-[280px] sm:w-[340px] lg:w-[500px] aspect-square"
    >
        <div
            id="avatarImage"
            role="button"
            class="flex_center w-[130px] xs:w-[150px] sm:w-[180px] lg:w-[250px] aspect-square rounded-full z-10 cursor-pointer"
            style={{ opacity: 0 }}
        >
            <Image
                src={config.avatar}
                alt=`${config.firstName} ${config.lastName} Avatar`
                class="object-cover w-full h-full rounded-full noDrag"
                width="250"
                height="250"
                priority
            />
        </div>

        <!-- Orbit Trails -->
        <div class="Spring_Up Hero_Trail Trail1">
            <span class="Orbit_Dot"></span>
        </div>
        <div class="Spring_Up Hero_Trail Trail2">
            <span class="Orbit_Dot"></span>
        </div>
        <div class="Spring_Up Hero_Trail Trail3">
            <span class="Orbit_Dot"></span>
        </div>
        <div class="Spring_Up Hero_Trail Trail4">
            <span class="Orbit_Dot"></span>
        </div>
    </div>
</section>
