---
import { Image } from "astro:assets";

const { config } = Astro.props;
---

<section
    id="Hero"
    class="w-full h-[calc(100vh-4rem)] max-[375px]:h-auto max-[375px]:min-h-[calc(100svh-4rem)] py-4 bg-background flex justify-evenly lg:justify-around items-center flex-col-reverse lg:flex-row overflow-hidden max-[375px]:overflow-visible max-[375px]:gap-2"
>
    <!-- Hero Intro Info -->
    <div class="w-full lg:w-fit flex justify-start items-center flex-col gap-8 max-[375px]:gap-3">
        <div class="text-[18px] max-[375px]:text-[15px] lg:text-[26px] text-center lg:text-left">
            <p class="Fade_Stagger">{config.salutation}</p>
            <h1
                class="Fade_Stagger gradientText font-ubuntu text-[4em] max-[375px]:text-[3.25em] lg:text-[9rem] leading-tight max-w-xs max-[375px]:max-w-[9ch] md:max-w-6xl"
            >
                {config.firstName}
                {" " + config.lastName}
            </h1>
            <p class="Fade_Stagger">I'm a {config.position}.</p>
            <p class="Fade_Stagger">
                {config.tagLine.prefixText}
                <span class="gradientText font-ubuntu">
                    {config.tagLine.highlightedText}
                </span>
                {config.tagLine.suffixText}
            </p>
        </div>

        <div
            class="Fade_Stagger flex justify-center lg:justify-start items-center w-full gap-10 max-[375px]:gap-8 py-4 max-[375px]:py-2 text-socialIconColor!"
        >
            {
                config.links &&
                    config.links.map(
                        (link: {
                            label: string;
                            url: string;
                            icon: string;
                        }) => (
                            <a
                                href={link.url}
                                title={link.label}
                                aria-label={link.label}
                                target="_blank"
                                rel="noreferrer"
                                class="Fade_Stagger w-9 h-9 flex items-center justify-center [&>svg]:w-full [&>svg]:h-full"
                            >
                                <Fragment set:html={link.icon} />
                            </a>
                        ),
                    )
            }
        </div>
    </div>

    <!-- Hero Orbit Animation -->
    <div
        class="Hero_Orbit relative flex_center w-[340px] max-[375px]:w-[260px] lg:w-[500px] aspect-square"
    >
        <div
            id="avatarImage"
            role="button"
            class="flex_center w-[180px] max-[375px]:w-[150px] sm:w-[250px] aspect-square rounded-full z-10 cursor-pointer"
            style={{ opacity: 0 }}
        >
            <Image
                src={config.avatar}
                alt=`${config.firstName} ${config.lastName} Avatar`
                class="object-cover w-full h-full rounded-full noDrag"
                width="180"
                height="180"
                priority
            />
        </div>

        <!-- Orbit Trails -->
        <div class="Spring_Up Hero_Trail Trail1">
            <span class="Orbit_Dot"></span>
        </div>
        <div class="Spring_Up Hero_Trail Trail2">
            <span class="Orbit_Dot"></span>
        </div>
        <div class="Spring_Up Hero_Trail Trail3">
            <span class="Orbit_Dot"></span>
        </div>
        <div class="Spring_Up Hero_Trail Trail4">
            <span class="Orbit_Dot"></span>
        </div>
    </div>
</section>
